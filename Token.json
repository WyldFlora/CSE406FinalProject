{
  "abi": [
    {
      "name": "balanceOf",
      "type": "function",
      "stateMutability": "view",
      "inputs": [{"name":"account","type":"address"}],
      "outputs": [{"type":"uint256"}]
    },
    {
      "name": "approve",
      "type": "function",
      "stateMutability": "nonpayable",
      "inputs": [
        {"name":"spender","type":"address"},
        {"name":"amount","type":"uint256"}
      ],
      "outputs": [{"type":"bool"}]
    },
    {
      "name": "transferFrom",
      "type": "function",
      "stateMutability": "nonpayable",
      "inputs": [
        {"name":"from","type":"address"},
        {"name":"to","type":"address"},
        {"name":"amount","type":"uint256"}
      ],
      "outputs": [{"type":"bool"}]
    },
    {
      "name": "decimals",
      "type": "function",
      "stateMutability": "view",
      "inputs": [],
      "outputs": [{"type":"uint8"}]
    }
  ]
}